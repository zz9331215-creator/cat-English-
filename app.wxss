page {
  --color-primary: #FF9D42;
  --color-primary-light: #FFF3E6;
  --color-bg: #F7F7F8;
  --color-card: #FFFFFF;
  --color-text: #1A1A1A;
  --color-text-secondary: #8E8E93;
  --color-border: #F0F0F2;
  --color-black: #1A1A1A;
  --color-success: #34C759;
  --color-danger: #FF6B6B;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --shadow-card: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);

  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view, text, image, button {
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.3;
}

.section-subtitle {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: var(--color-black);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  padding: 0 48rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: #FFF8E7;
  color: var(--color-text);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.orange-underline {
  position: relative;
  display: inline-block;
}

.orange-underline::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 2rpx;
  width: 100%;
  height: 12rpx;
  background: linear-gradient(90deg, #FF9D42 0%, #FFB86C 100%);
  border-radius: 6rpx;
  opacity: 0.5;
  z-index: -1;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
