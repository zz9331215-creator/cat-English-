<view class="container home-page">
  <view class="status-bar">
    <view class="status-item growth">
      <view class="status-icon">{{t.iconHeart}}</view>
      <view class="status-info">
        <text class="status-value">{{pet.exp}}/{{pet.maxExp}}</text>
        <text class="status-label">{{stageName}}</text>
      </view>
      <view class="status-progress">
        <view class="status-progress-fill" style="width: {{growthPercent}}%"></view>
      </view>
    </view>
    <view class="status-item satiety">
      <view class="status-icon">{{t.iconFish}}</view>
      <view class="status-info">
        <text class="status-value">{{pet.satiety}}%</text>
        <text class="status-label">{{t.satiety}}</text>
      </view>
    </view>
    <view class="status-item currency">
      <view class="status-icon">{{t.iconFish}}</view>
      <view class="status-info">
        <text class="status-value">{{catStrips}}</text>
        <text class="status-label">{{t.catStrips}}</text>
      </view>
    </view>
  </view>
  <view class="room-scene">
    <view class="room-wall"></view>
    <view class="room-floor"></view>
    <view class="deco window">
      <view class="curtain curtain-left"></view>
      <view class="curtain curtain-right"></view>
    </view>
    <view class="deco photo photo-1">
      <image class="photo-img" src="/assets/images/kitten-cat.apng" mode="aspectFill" />
    </view>
    <view class="deco photo photo-2">{{t.iconCat}}</view>
    <view class="deco board">
      <text class="board-text">{{t.boardText}}</text>
    </view>
    <view class="deco cat-tree">{{t.iconTree}}</view>
    <view class="deco rug"></view>
    <view class="speech-bubble" wx:if="{{showSpeech}}">
      <text class="speech-text">{{speechText}}</text>
      <view class="speech-btn" wx:if="{{pet.mood === 'hungry'}}" bindtap="onHungryAction">{{catStrips > 0 ? t.goFeed : t.goLearn}}</view>
    </view>
    <view class="kitten-area" bindtap="onKittenTap">
      <video-cat
        width="{{catImageWidth}}"
        height="{{catImageWidth}}"
        size="{{petDisplaySize}}"
        mood="{{pet.mood}}"
        action="{{kittenAction === 'eating' ? 'eating' : 'idle'}}"
        webp-src="/assets/video/cat-hungry.webp"
        gif-src="/assets/video/cat-hungry.gif"
        mp4-src="/assets/video/cat-hungry.mp4"
      />
    </view>
  </view>
  <view class="side-menu">
    <view class="menu-item" bindtap="goWords">
      <view class="menu-icon">{{t.iconBook}}</view>
      <text class="menu-label">{{t.menuWords}}</text>
    </view>
    <view class="menu-item" bindtap="goSpeaking">
      <view class="menu-icon">{{t.iconMic}}</view>
      <text class="menu-label">{{t.menuSpeaking}}</text>
    </view>
    <view class="menu-item" bindtap="goShop">
      <view class="menu-icon">{{t.iconHome}}</view>
      <text class="menu-label">{{t.menuShop}}</text>
    </view>
  </view>
  <view class="bottom-actions">
    <view class="feed-btn {{catStrips > 0 ? '' : 'disabled'}}" bindtap="feedKitten">
      <text class="feed-icon">{{t.iconFish}}</text>
      <text class="feed-text">{{t.feedCat}}</text>
      <text class="feed-cost">-1</text>
    </view>
    <view class="learn-btn" bindtap="goLearn">
      <text>{{t.startLearn}}</text>
    </view>
  </view>
  <view class="reward-modal" wx:if="{{showReward}}" bindtap="closeReward">
    <view class="reward-content" catchtap="">
      <text class="reward-emoji">{{t.iconParty}}</text>
      <text class="reward-title">{{t.feedSuccess}}</text>
      <text class="reward-desc">{{t.feedSuccessDesc}} {{rewardExp}} {{t.expUnit}}</text>
      <text class="reward-stage" wx:if="{{stageUp}}">{{t.stageUp}} {{stageName}}</text>
    </view>
  </view>
</view>
