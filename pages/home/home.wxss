.home-page {
  background: linear-gradient(180deg, #D4EDDA 0%, #E8F5E9 40%, #FFF8E7 100%);
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

/* 状态栏 */
.status-bar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 24rpx 0;
  position: relative;
  z-index: 10;
}

.status-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.status-icon {
  font-size: 36rpx;
}

.status-info {
  display: flex;
  flex-direction: column;
}

.status-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.status-label {
  font-size: 20rpx;
  color: #8E8E93;
}

.status-progress {
  position: absolute;
  bottom: 0;
  left: 20rpx;
  right: 20rpx;
  height: 6rpx;
  background: #F0F0F0;
  border-radius: 3rpx;
  overflow: hidden;
}

.growth {
  position: relative;
  padding-bottom: 20rpx;
}

.status-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF9D42, #FFB86C);
  border-radius: 3rpx;
  transition: width 0.5s ease;
}

/* 房间场景 */
.room-scene {
  position: relative;
  height: 65vh;
  margin: 24rpx;
  border-radius: 32rpx;
  overflow: hidden;
  border: 4rpx solid rgba(85, 85, 85, 0.15);
}

.room-wall {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #C8E6C9 0%, #DCEDC8 60%, #FFF9C4 100%);
}

.room-wall::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, rgba(255, 182, 193, 0.3) 8rpx, transparent 8rpx);
  background-size: 60rpx 60rpx;
}

.room-floor {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 30%;
  background: repeating-linear-gradient(
    90deg,
    #F5E6C8 0rpx,
    #F5E6C8 40rpx,
    #EDD9B5 40rpx,
    #EDD9B5 80rpx
  );
  border-top: 4rpx solid #D4C4A0;
}

/* 装饰�? */
.deco {
  position: absolute;
  z-index: 2;
}

.window {
  top: 40rpx;
  left: 20rpx;
  width: 120rpx;
  height: 140rpx;
  background: #B3E5FC;
  border: 6rpx solid #8D6E63;
  border-radius: 8rpx;
}

.curtain {
  position: absolute;
  top: -10rpx;
  width: 50rpx;
  height: 160rpx;
  background: #A5D6A7;
  border-radius: 0 0 20rpx 20rpx;
}

.curtain-left { left: -10rpx; }
.curtain-right { right: -10rpx; }

.photo {
  width: 60rpx;
  height: 70rpx;
  background: #FFFFFF;
  border: 4rpx solid #8D6E63;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 2rpx 4rpx 8rpx rgba(0,0,0,0.1);
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 2rpx;
}

.photo-1 { top: 60rpx; right: 180rpx; transform: rotate(-5deg); }
.photo-2 { top: 80rpx; right: 100rpx; transform: rotate(3deg); }

.board {
  top: 50rpx;
  right: 30rpx;
  width: 140rpx;
  height: 100rpx;
  background: #81C784;
  border: 4rpx solid #558B2F;
  border-radius: 8rpx;
  padding: 12rpx;
  display: flex;
  align-items: center;
}

.board-text {
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 600;
  text-align: center;
  line-height: 1.4;
}

.cat-tree {
  bottom: 28%;
  right: 30rpx;
  font-size: 80rpx;
}

.rug {
  bottom: 22%;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 80rpx;
  background: radial-gradient(ellipse, #A5D6A7 0%, #81C784 100%);
  border-radius: 50%;
  opacity: 0.6;
}

/* 对话气泡 */
.speech-bubble {
  position: absolute;
  top: 180rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  max-width: 80%;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  border: 3rpx solid #E0E0E0;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.speech-bubble::after {
  content: '';
  position: absolute;
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  border: 10rpx solid transparent;
  border-top-color: #FFFFFF;
}

.speech-text {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.speech-btn {
  background: #FF9D42;
  color: #FFF;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* 小猫区域 */
.kitten-area {
  position: absolute;
  bottom: 22%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 6;
  width: 320rpx;
  height: 340rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: visible;
  pointer-events: auto;
}

/* 右侧菜单 */
.side-menu {
  position: fixed;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 10;
}

.menu-item {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.menu-icon {
  font-size: 36rpx;
}

.menu-label {
  font-size: 18rpx;
  color: #666;
  margin-top: 4rpx;
}

/* 底部操作 */
.bottom-actions {
  position: fixed;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  right: 24rpx;
  display: flex;
  gap: 20rpx;
  z-index: 10;
}

.feed-btn {
  width: 160rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF9D42, #FFB86C);
  border-radius: 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 157, 66, 0.4);
  position: relative;
}

.feed-btn.disabled {
  opacity: 0.5;
}

.feed-icon {
  font-size: 36rpx;
}

.feed-text {
  font-size: 22rpx;
  color: #FFF;
  font-weight: 600;
}

.feed-cost {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #FF6B6B;
  color: #FFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.learn-btn {
  flex: 1;
  height: 100rpx;
  background: #1A1A1A;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFF;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

/* 奖励弹窗 */
.reward-modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.reward-content {
  background: #FFF;
  border-radius: 32rpx;
  padding: 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: pop-in 0.3s ease;
}

@keyframes pop-in {
  0% { transform: scale(0.5); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.reward-emoji {
  font-size: 80rpx;
}

.reward-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 20rpx;
}

.reward-desc {
  font-size: 28rpx;
  color: #666;
  margin-top: 12rpx;
}

.reward-stage {
  font-size: 30rpx;
  color: #FF9D42;
  font-weight: 600;
  margin-top: 16rpx;
}
