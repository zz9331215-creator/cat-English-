<view class="container speaking-page">
  <view class="header">
    <view class="section-title">{{t.speakingTitle}}<text class="orange-underline">{{t.speakingTitleHighlight}}</text></view>
    <text class="section-subtitle">{{t.speakingSubtitle}}</text>
  </view>
  <view class="topic-card">
    <view class="topic-header">
      <text class="topic-tag">{{t.speakingTodayTopic}}</text>
      <text class="topic-title">{{topic.title}}</text>
    </view>
    <text class="topic-prompt">{{topic.prompt}}</text>
    <text class="topic-hint">{{t.iconBulb}} {{t.speakingHintPrefix}}{{topic.hint}}</text>
  </view>
  <view class="companion-area">
    <kitten-avatar size="0.72" stage="kitten" mood="{{isRecording ? 'happy' : 'normal'}}" action="studying" />
    <text class="companion-text" wx:if="{{isRecording}}">{{t.speakingListening}}</text>
  </view>
  <view class="timer-area">
    <text class="speak-timer">{{timerDisplay}}</text>
  </view>
  <view class="record-btn {{isRecording ? 'recording' : ''}}" bindtap="toggleRecord">
    <view class="record-inner">
      <text>{{isRecording ? t.speakingStop : t.speakingRecord}}</text>
    </view>
  </view>
  <button class="btn-secondary finish-btn" bindtap="finishPractice">{{t.speakingFinish}}</button>
</view>
