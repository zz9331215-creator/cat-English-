.focus-page {
  padding: 40rpx 32rpx;
  background: #FFFFFF;
}

.header {
  margin-bottom: 40rpx;
}

.timer-ring-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.timer-ring {
  position: relative;
  width: 400rpx;
  height: 400rpx;
}

.ring-progress {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: conic-gradient(
    #FF9D42 calc(var(--progress) * 1%),
    #F0F0F0 calc(var(--progress) * 1%)
  );
  mask: radial-gradient(transparent 58%, #000 59%);
  -webkit-mask: radial-gradient(transparent 58%, #000 59%);
}

.ring-inner {
  position: absolute;
  inset: 40rpx;
  border-radius: 50%;
  background: #FAFAFA;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.community-tag {
  margin-top: 20rpx;
  background: rgba(0, 0, 0, 0.05);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #8E8E93;
}

.timer-display {
  text-align: center;
  margin-bottom: 40rpx;
  position: relative;
}

.timer-text {
  font-size: 96rpx;
  font-weight: 700;
  color: #1A1A1A;
  font-variant-numeric: tabular-nums;
  letter-spacing: 4rpx;
}

.reward-hint {
  position: absolute;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #FF9D42;
  font-size: 28rpx;
  font-weight: 600;
  animation: float 2s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(-50%); }
  50% { transform: translateY(-60%); }
}

.type-selector {
  display: flex;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.type-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 80rpx;
  background: #F7F7F8;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #8E8E93;
  border: 2rpx solid transparent;
}

.type-item.active {
  background: #FFF3E6;
  color: #FF9D42;
  border-color: #FF9D42;
  font-weight: 600;
}

.type-icon {
  font-size: 32rpx;
}

.action-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.bowl-btn {
  width: 96rpx;
  height: 96rpx;
  background: #F7F7F8;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.start-btn {
  flex: 1;
}

.quick-links {
  display: flex;
  justify-content: space-around;
  padding: 32rpx;
  background: #F7F7F8;
  border-radius: 24rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.quick-icon {
  font-size: 40rpx;
}

.quick-label {
  font-size: 24rpx;
  color: #8E8E93;
}
