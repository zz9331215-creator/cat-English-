<view class="container focus-page">
  <view class="header">
    <text class="section-title">专注学英语</text>
    <text class="section-subtitle">和咪咪一起进步</text>
  </view>

  <!-- 番茄钟圆环 -->
  <view class="timer-ring-wrap">
    <view class="timer-ring">
      <view class="ring-progress" style="--progress: {{progressPercent}}"></view>
      <view class="ring-inner">
        <lottie-cat width="200" height="200" size="0.7" mood="happy" action="studying" />
      </view>
    </view>
    <view class="community-tag">
      <text>{{onlineCount}} 人正在专注</text>
    </view>
  </view>

  <!-- 计时器 -->
  <view class="timer-display">
    <text class="timer-text">{{timerDisplay}}</text>
    <text class="reward-hint" wx:if="{{isRunning}}">+{{expectedReward}} 猫条</text>
  </view>

  <!-- 学习类型选择 -->
  <view class="type-selector">
    <view
      class="type-item {{learnType === 'words' ? 'active' : ''}}"
      data-type="words"
      bindtap="selectType"
    >
      <text class="type-icon">📖</text>
      <text>背单词</text>
    </view>
    <view
      class="type-item {{learnType === 'speaking' ? 'active' : ''}}"
      data-type="speaking"
      bindtap="selectType"
    >
      <text class="type-icon">🎤</text>
      <text>练口语</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <view class="bowl-btn" bindtap="quickFeed">
      <text>🍽️</text>
    </view>
    <button class="btn-primary start-btn" bindtap="toggleTimer">
      <text wx:if="{{!isRunning}}">🐾 开始</text>
      <text wx:else>⏸ 暂停</text>
    </button>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-links">
    <view class="quick-item" bindtap="goWords">
      <text class="quick-icon">📚</text>
      <text class="quick-label">单词本</text>
    </view>
    <view class="quick-item" bindtap="goSpeaking">
      <text class="quick-icon">💬</text>
      <text class="quick-label">口语练习</text>
    </view>
    <view class="quick-item" bindtap="goHome">
      <text class="quick-icon">🏠</text>
      <text class="quick-label">喵屋</text>
    </view>
  </view>
</view>
