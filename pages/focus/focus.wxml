<view class="container focus-page">
  <view class="header">
    <text class="section-title">{{t.focusTitle}}</text>
    <text class="section-subtitle">{{t.focusSubtitle}}</text>
  </view>
  <view class="timer-ring-wrap">
    <view class="timer-ring">
      <view class="ring-progress" style="--progress: {{progressPercent}}"></view>
      <view class="ring-inner">
        <video-cat
          width="280"
          height="280"
          size="{{petDisplaySize}}"
          mood="{{petMood}}"
          action="{{kittenAction}}"
        />
      </view>
    </view>
    <view class="community-tag">
      <text>{{onlineCount}}{{t.focusOnlineSuffix}}</text>
    </view>
  </view>
  <view class="timer-display">
    <text class="timer-text">{{timerDisplay}}</text>
    <text class="reward-hint" wx:if="{{isRunning}}">+{{expectedReward}}{{t.focusRewardSuffix}}</text>
  </view>
  <view class="type-selector">
    <view class="type-item {{learnType === 'words' ? 'active' : ''}}" data-type="words" bindtap="selectType">
      <text class="type-icon">{{t.iconBook}}</text>
      <text>{{t.focusTypeWords}}</text>
    </view>
    <view class="type-item {{learnType === 'speaking' ? 'active' : ''}}" data-type="speaking" bindtap="selectType">
      <text class="type-icon">{{t.iconMic}}</text>
      <text>{{t.focusTypeSpeaking}}</text>
    </view>
  </view>
  <view class="action-bar">
    <view class="bowl-btn" bindtap="quickFeed"><text>{{t.iconBowl}}</text></view>
    <button class="btn-primary start-btn" bindtap="toggleTimer">
      <text wx:if="{{!isRunning}}">{{t.iconPaw}} {{t.focusStart}}</text>
      <text wx:else>{{t.focusPause}}</text>
    </button>
  </view>
  <view class="quick-links">
    <view class="quick-item" bindtap="goWords">
      <text class="quick-icon">{{t.iconBooks}}</text>
      <text class="quick-label">{{t.focusWordBook}}</text>
    </view>
    <view class="quick-item" bindtap="goSpeaking">
      <text class="quick-icon">{{t.iconChat}}</text>
      <text class="quick-label">{{t.focusSpeakingPractice}}</text>
    </view>
    <view class="quick-item" bindtap="goHome">
      <text class="quick-icon">{{t.iconHome}}</text>
      <text class="quick-label">{{t.tabHome}}</text>
    </view>
  </view>
</view>
