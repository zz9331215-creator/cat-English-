<view class="container stats-page">
  <view class="stats-header">
    <text class="section-title">{{t.statsTitle}}</text>
  </view>
  <view class="time-tabs">
    <view
      class="time-tab {{activeTab === item ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="*this"
      data-tab="{{item}}"
      bindtap="switchTab"
    >{{item}}</view>
  </view>
  <view class="overview-card card">
    <text class="card-title">{{t.statsOverview}}</text>
    <view class="metrics-grid">
      <view class="metric-item">
        <text class="metric-value">{{stats.focusCount}}</text>
        <text class="metric-label">{{t.metricFocus}}</text>
      </view>
      <view class="metric-item">
        <text class="metric-value">{{stats.wordsLearned}}</text>
        <text class="metric-label">{{t.metricWords}}</text>
      </view>
      <view class="metric-item highlight">
        <text class="metric-value">{{catStrips}}</text>
        <text class="metric-label">{{t.metricStripsTotal}}</text>
      </view>
      <view class="metric-item">
        <text class="metric-value">{{stats.speakingMinutes}}</text>
        <text class="metric-label">{{t.metricSpeaking}}</text>
      </view>
      <view class="metric-item">
        <text class="metric-value">{{stats.feedCount}}</text>
        <text class="metric-label">{{t.metricFeed}}</text>
      </view>
      <view class="metric-item">
        <text class="metric-value">{{totalMinutes}}</text>
        <text class="metric-label">{{t.metricTotalTime}}</text>
      </view>
    </view>
  </view>
  <view class="heatmap-card card">
    <text class="card-title">{{t.statsCheckin}}</text>
    <view class="heatmap">
      <view
        class="heat-cell level-{{item.level}}"
        wx:for="{{heatmap}}"
        wx:key="date"
      ></view>
    </view>
    <view class="heat-legend">
      <text class="legend-label">{{t.legendLess}}</text>
      <view class="heat-cell level-0"></view>
      <view class="heat-cell level-1"></view>
      <view class="heat-cell level-2"></view>
      <view class="heat-cell level-3"></view>
      <text class="legend-label">{{t.legendMore}}</text>
    </view>
  </view>
  <view class="growth-card card">
    <text class="card-title">{{t.statsGrowth}}</text>
    <view class="stage-timeline">
      <view
        class="stage-item {{item.reached ? 'reached' : ''}} {{item.current ? 'current' : ''}}"
        wx:for="{{stages}}"
        wx:key="key"
      >
        <view class="stage-dot"></view>
        <text class="stage-name">{{item.name}}</text>
      </view>
    </view>
  </view>
</view>
