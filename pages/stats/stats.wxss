.stats-page {
  padding: 32rpx;
}

.stats-header {
  margin-bottom: 24rpx;
}

.time-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.time-tab {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #8E8E93;
  background: #F0F0F0;
}

.time-tab.active {
  background: #1A1A1A;
  color: #FFF;
  font-weight: 600;
}

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  display: block;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.metric-item {
  text-align: center;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
}

.metric-item.highlight .metric-value {
  color: #FF9D42;
}

.metric-label {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

.heatmap {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.heat-cell {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
}

.heat-cell.level-0 { background: #F0F0F0; }
.heat-cell.level-1 { background: #FFE0B2; }
.heat-cell.level-2 { background: #FFB74D; }
.heat-cell.level-3 { background: #FF9D42; }

.heat-legend {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 16rpx;
  justify-content: flex-end;
}

.legend-label {
  font-size: 20rpx;
  color: #8E8E93;
}

.stage-timeline {
  display: flex;
  justify-content: space-between;
  position: relative;
  padding: 20rpx 0;
}

.stage-timeline::before {
  content: '';
  position: absolute;
  top: 32rpx;
  left: 10%;
  right: 10%;
  height: 4rpx;
  background: #F0F0F0;
}

.stage-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.stage-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #E0E0E0;
  margin-bottom: 8rpx;
}

.stage-item.reached .stage-dot {
  background: #FF9D42;
}

.stage-item.current .stage-dot {
  background: #FF9D42;
  box-shadow: 0 0 0 6rpx rgba(255, 157, 66, 0.3);
}

.stage-name {
  font-size: 20rpx;
  color: #8E8E93;
}

.stage-item.reached .stage-name,
.stage-item.current .stage-name {
  color: #1A1A1A;
  font-weight: 600;
}
