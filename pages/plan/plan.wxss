.plan-page {
  padding: 32rpx;
  background: #F7F7F8;
}

.tab-header {
  display: flex;
  gap: 40rpx;
  margin-bottom: 32rpx;
}

.tab {
  font-size: 36rpx;
  color: #8E8E93;
  font-weight: 500;
  position: relative;
}

.tab.active {
  color: #1A1A1A;
  font-weight: 700;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 0;
  width: 100%;
  height: 6rpx;
  background: #FF9D42;
  border-radius: 3rpx;
}

.calendar-section {
  margin-bottom: 32rpx;
}

.month-text {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: block;
}

.week-row, .date-row {
  display: flex;
  justify-content: space-between;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #8E8E93;
}

.date-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.date-num {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 50%;
}

.date-item.today .date-num {
  background: #1A1A1A;
  color: #FFF;
  font-weight: 600;
}

.date-dot {
  width: 8rpx;
  height: 8rpx;
  background: #34C759;
  border-radius: 50%;
  margin-top: 4rpx;
}

.plan-cat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 28rpx 16rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(180deg, #fff 0%, #f8faf8 100%);
  overflow: visible;
}

.plan-cat-hint {
  width: 100%;
  text-align: center;
  margin-top: 8rpx;
}

.plan-cat-stage {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.plan-cat-desc {
  display: block;
  font-size: 24rpx;
  color: #8e8e93;
  margin-top: 4rpx;
}

.daily-progress {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
}

.progress-ring {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 8rpx solid #F0F0F0;
  border-top-color: #FF9D42;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-text {
  font-size: 28rpx;
  font-weight: 700;
}

.progress-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.progress-desc {
  font-size: 26rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

.task-card {
  background: #FFF;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #81C784;
}

.task-check {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #E0E0E0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFF;
  flex-shrink: 0;
}

.task-check.checked {
  background: #34C759;
  border-color: #34C759;
}

.task-content {
  flex: 1;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.task-status {
  font-size: 24rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

.task-action {
  background: #FFF8E7;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  width: 120rpx;
  height: 120rpx;
  background: #1A1A1A;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  z-index: 10;
}

.fab-icon {
  font-size: 36rpx;
}

.fab-text {
  font-size: 20rpx;
  color: #FFF;
  margin-top: 2rpx;
}
