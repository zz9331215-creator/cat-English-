<view class="container plan-page">
  <view class="tab-header">
    <text class="tab active">{{t.planTabDaily}}</text>
    <text class="tab">{{t.planTabGoal}}</text>
  </view>
  <view class="calendar-section">
    <view class="month-row">
      <text class="month-text">{{monthText}}</text>
    </view>
    <view class="week-row">
      <text class="week-day" wx:for="{{weekDays}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="date-row">
      <view
        class="date-item {{item.isToday ? 'today' : ''}}"
        wx:for="{{dates}}"
        wx:key="key"
      >
        <text class="date-num">{{item.isToday ? t.planToday : item.date}}</text>
        <view class="date-dot" wx:if="{{item.hasRecord}}"></view>
      </view>
    </view>
  </view>
  <view class="plan-cat-card card">
    <apng-cat width="{{catImageWidth}}" />
    <view class="plan-cat-hint" wx:if="{{stageName}}">
      <text class="plan-cat-stage">{{stageName}}</text>
      <text class="plan-cat-desc">{{progressDesc}}</text>
    </view>
  </view>
  <view class="daily-progress card">
    <view class="progress-ring">
      <text class="ring-text">{{dailyPercent}}%</text>
    </view>
    <view class="progress-info">
      <text class="progress-title">{{t.planProgressTitle}}</text>
      <text class="progress-desc">{{progressDesc}}</text>
    </view>
  </view>
  <view class="task-list">
    <view class="task-card" wx:for="{{tasks}}" wx:key="id">
      <view class="task-check {{item.done ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="toggleTask">
        <text wx:if="{{item.done}}">{{t.checkMark}}</text>
      </view>
      <view class="task-content">
        <text class="task-title">{{item.title}}</text>
        <text class="task-status">{{item.done ? t.planTaskDone : t.planTaskToday}} {{item.current}}/{{item.target}}</text>
      </view>
      <view class="task-action" data-type="{{item.type}}" bindtap="goPractice">
        <text>{{t.planGoPractice}}</text>
      </view>
    </view>
  </view>
  <view class="fab" bindtap="addTask">
    <text class="fab-icon">{{t.iconPaw}}</text>
    <text class="fab-text">{{t.planFabNew}}</text>
  </view>
</view>
