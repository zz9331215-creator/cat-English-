<view class="container profile-page">
  <view class="user-header">
    <view class="avatar-img">🐱</view>
    <view class="user-info">
      <text class="username">{{user.nickname}}</text>
      <text class="user-id">{{t.profileStudyDays}} {{studyDays}}{{t.profileDaysUnit}}</text>
    </view>
    <view class="header-actions">
      <text class="action-icon">{{t.iconGear}}</text>
    </view>
  </view>
  <view class="pet-card">
    <view class="pet-card-inner">
      <text class="pet-card-title">{{t.iconCat}} {{pet.name}} {{stageName}}</text>
      <text class="pet-card-desc">{{t.profileExpLabel}} {{pet.exp}} {{t.profileSatietyLabel}} {{pet.satiety}}%</text>
      <view class="pet-card-stats">
        <view class="pet-stat">
          <text class="pet-stat-value">{{catStrips}}</text>
          <text class="pet-stat-label">{{t.catStrips}}</text>
        </view>
        <view class="pet-stat">
          <text class="pet-stat-value">{{stats.wordsLearned}}</text>
          <text class="pet-stat-label">{{t.profileWords}}</text>
        </view>
        <view class="pet-stat">
          <text class="pet-stat-value">{{stats.speakingMinutes}}m</text>
          <text class="pet-stat-label">{{t.profileSpeaking}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="settings-section card">
    <text class="section-label">{{t.settingsLearn}}</text>
    <view class="setting-item">
      <text>{{t.settingsDailyWords}}</text>
      <text class="setting-value">{{settings.dailyWordGoal}}{{t.settingsUnitWord}}</text>
    </view>
    <view class="setting-item">
      <text>{{t.settingsDailySpeaking}}</text>
      <text class="setting-value">{{settings.dailySpeakingGoal}}{{t.settingsUnitMinute}}</text>
    </view>
    <view class="setting-item">
      <text>{{t.settingsFocusDuration}}</text>
      <text class="setting-value">{{settings.focusDuration}}{{t.settingsUnitMinute}}</text>
    </view>
  </view>
  <view class="settings-section card">
    <text class="section-label">{{t.settingsOther}}</text>
    <view class="setting-item" bindtap="resetData">
      <text>{{t.settingsReset}}</text>
      <text class="setting-arrow">></text>
    </view>
    <view class="setting-item">
      <text>{{t.settingsAbout}}</text>
      <text class="setting-arrow">></text>
    </view>
    <view class="setting-item">
      <text>{{t.settingsPrivacy}}</text>
      <text class="setting-arrow">></text>
    </view>
  </view>
</view>
