.profile-page {
  padding: 32rpx;
}

.user-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.avatar-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #FFF3E6;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #FFF3E6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
}

.user-id {
  font-size: 24rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

.action-icon {
  font-size: 40rpx;
}

.pet-card {
  background: linear-gradient(135deg, #1A1A1A 0%, #333 100%);
  border-radius: 24rpx;
  padding: 4rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.pet-card-inner {
  background: linear-gradient(135deg, #2A2A2A 0%, #1A1A1A 100%);
  border-radius: 22rpx;
  padding: 32rpx;
}

.pet-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFF;
  display: block;
}

.pet-card-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
  display: block;
}

.pet-card-stats {
  display: flex;
  gap: 40rpx;
  margin-top: 24rpx;
}

.pet-stat {
  text-align: center;
}

.pet-stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF9D42;
  display: block;
}

.pet-stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.settings-section {
  padding: 0;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.section-label {
  font-size: 26rpx;
  color: #8E8E93;
  padding: 24rpx 28rpx 12rpx;
  display: block;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-top: 1rpx solid #F0F0F0;
  font-size: 30rpx;
}

.setting-value {
  color: #8E8E93;
  font-size: 28rpx;
}

.setting-arrow {
  color: #C0C0C0;
  font-size: 28rpx;
}
