<view class="container shop-page">
  <view class="shop-header">
    <text class="section-title">{{t.shopTitle}}</text>
    <text class="balance">{{t.shopBalance}} {{catStrips}}</text>
  </view>
  <view class="shop-grid">
    <view class="shop-item" wx:for="{{items}}" wx:key="id">
      <text class="item-emoji">{{item.emoji}}</text>
      <text class="item-name">{{item.name}}</text>
      <text class="item-desc">{{item.desc}}</text>
      <view class="item-price">
        <text>{{item.price}}{{t.shopPriceUnit}}</text>
      </view>
      <view class="buy-btn {{catStrips >= item.price ? '' : 'disabled'}}" data-id="{{item.id}}" bindtap="buyItem">
        {{t.shopRedeem}}
      </view>
    </view>
  </view>
  <view class="earn-tip card">
    <text class="tip-title">{{t.shopEarnTitle}}</text>
    <text class="tip-item">{{t.shopTip1}}</text>
    <text class="tip-item">{{t.shopTip2}}</text>
    <text class="tip-item">{{t.shopTip3}}</text>
  </view>
</view>
