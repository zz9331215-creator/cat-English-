<view class="container words-page">
  <view class="progress-header">
    <text class="progress-text">{{currentIndex + 1}} / {{words.length}}</text>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progressPercent}}%"></view>
    </view>
    <text class="strips-earned">已获 🐟 {{earnedStrips}}</text>
  </view>

  <!-- 单词卡片 -->
  <view class="word-card {{showMeaning ? 'flipped' : ''}}" bindtap="flipCard">
    <view class="card-front">
      <text class="word-text">{{currentWord.word}}</text>
      <text class="phonetic">{{currentWord.phonetic}}</text>
      <text class="tap-hint">点击翻转查看释义</text>
    </view>
    <view class="card-back">
      <text class="meaning">{{currentWord.meaning}}</text>
      <text class="example">{{currentWord.example}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-row">
    <view class="action-btn forget" bindtap="markForget">
      <text>😿 不认识</text>
    </view>
    <view class="action-btn know" bindtap="markKnow">
      <text>😺 认识了</text>
    </view>
  </view>

  <!-- 发音按钮 -->
  <view class="speak-row">
    <view class="speak-btn {{isPlaying ? 'playing' : ''}}" bindtap="playWord">
      <text>{{isPlaying ? '🔊 播放中...' : '🔊 发音'}}</text>
    </view>
    <view class="accent-btn" bindtap="toggleAccent">
      <text>{{accent === 'us' ? '🇺🇸 美音' : '🇬🇧 英音'}}</text>
    </view>
  </view>
</view>
